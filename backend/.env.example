# Required. This app has no built-in database hosting — point it at an
# external MongoDB (e.g. a free MongoDB Atlas cluster) when deploying to
# Vercel, since serverless functions can't host Mongo themselves.
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=createos

# Required. PoYo.ai powers all AI chat/image/video/music generation.
POYO_API_KEY=
POYO_BASE_URL=https://api.poyo.ai

# Comma-separated list of allowed origins for CORS. On Vercel, frontend and
# API are served from the same origin, so this can usually stay as "*".
CORS_ORIGINS=*
