# Required. Cloudflare D1 (serverless SQLite) stores posts and generations.
# 1. Create a D1 database: Cloudflare dashboard -> Workers & Pages -> D1 -> Create database
# 2. Run backend/schema.sql against it once (D1 database's Console tab, or
#    `wrangler d1 execute <database-name> --remote --file=backend/schema.sql`)
# 3. CF_ACCOUNT_ID: Cloudflare dashboard right sidebar (Account ID)
# 4. CF_D1_DATABASE_ID: the database's own page in the dashboard (Database ID)
# 5. CF_API_TOKEN: My Profile -> API Tokens -> Create Token, with D1 Edit permission
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# Required. PoYo.ai powers all AI chat/image/video/music generation.
POYO_API_KEY=
POYO_BASE_URL=https://api.poyo.ai

# Optional. Free stock photos & video (Pexels) for the Composer's stock picker.
# Get a free key at https://www.pexels.com/api/ (sign up -> Your API Key).
# No attribution required by Pexels' license, but the picker shows photographer
# credit anyway. Leave unset and the stock picker just reports it's not configured.
PEXELS_API_KEY=

# Optional. Lets people upload their own images/video/audio (used directly in
# posts, or as reference images for image/video generation). Vercel project ->
# Storage tab -> Create Database -> Blob -> connect to this project — Vercel
# sets this env var for you automatically, no separate account needed. Leave
# unset and /api/upload reports it's not configured.
BLOB_READ_WRITE_TOKEN=

# Comma-separated list of allowed origins for CORS. On Vercel, frontend and
# API are served from the same origin, so this can usually stay as "*".
CORS_ORIGINS=*

# Optional. Set this in Vercel and Vercel automatically sends it as a Bearer
# token on cron-triggered requests to /api/cron/publish-due, so the endpoint
# can tell a real cron firing from anyone else hitting the URL. Safe to leave
# unset for now — the endpoint reports due posts either way, it does not
# publish anything yet (no OAuth connections exist).
CRON_SECRET=
